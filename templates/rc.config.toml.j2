# {{ ansible_managed }}
schema_version = 1

[[aliases]]
name = "rustfs"
endpoint = {{ endpoint.url | to_json }}
access_key = {{ endpoint.access_key | to_json }}
secret_key = {{ endpoint.secret_key | to_json }}
bucket_lookup = {{ endpoint.bucket_lookup | to_json }}
insecure = {{ rustfs_insecure | bool | lower }}
{% if rustfs_client_ca_bundle %}
ca_bundle = {{ rustfs_client_ca_bundle | to_json }}
{% endif %}
