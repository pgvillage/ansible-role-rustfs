# {{ ansible_managed }}

# RustFS local/remote volumes.
{% if rustfs_server_cluster_nodes | length > 0 %}
RUSTFS_VOLUMES="{{ rustfs_server_cluster_nodes | join(' ') }}"
{% else %}
RUSTFS_VOLUMES="{{ rustfs_server_datadirs | join(' ') }}"
{% endif %}
# RustFS S3 API and console listen addresses.
RUSTFS_ADDRESS="{{ rustfs_server_addr }}"
RUSTFS_CONSOLE_ENABLE={{ rustfs_server_console_enable | bool | lower }}
RUSTFS_CONSOLE_ADDRESS="{{ rustfs_server_console_addr }}"
# Directory with the TLS certificate, key and CA chain.
RUSTFS_TLS_PATH="{{ rustfs_tls_path }}"

{% if rustfs_access_key %}
# Access Key of the server.
RUSTFS_ACCESS_KEY="{{ rustfs_access_key }}"
{% endif %}
{% if rustfs_secret_key %}
# Secret key of the server.
RUSTFS_SECRET_KEY="{{ rustfs_secret_key }}"
{% endif %}

{{ rustfs_server_env_extra }}
