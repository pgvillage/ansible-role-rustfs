# {{ ansible_managed }}

[Unit]
Description=RustFS Object Storage Server
Documentation=https://docs.rustfs.com
Wants=network-online.target
After=network-online.target
AssertFileIsExecutable={{ rustfs_server_bin }}

[Service]
Type=notify
NotifyAccess=main

WorkingDirectory={{ rustfs_server_workdir }}

User={{ rustfs_user }}
Group={{ rustfs_group }}

EnvironmentFile={{ rustfs_server_envfile }}
ExecStart={{ rustfs_server_bin }} server

LogsDirectory=rustfs
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE=1048576
LimitNPROC=32768
TasksMax=infinity

Restart=always
RestartSec=10s

# Type=notify waits for READY=1, so the start timeout must cover RustFS initialization
TimeoutStartSec=120s
TimeoutStopSec=45s

# Hardening, as in the upstream unit
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

{% if (rustfs_server_addr.split(':')[-1] | int) < 1024 or (rustfs_server_console_addr.split(':')[-1] | int) < 1024 %}
AmbientCapabilities=CAP_NET_BIND_SERVICE
{% endif %}

[Install]
WantedBy=multi-user.target
